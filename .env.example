# Browser
HEADLESS=true

# GapGPT chat
BASE_URL=https://gapgpt.app/chat
LOGIN_URL=https://gapgpt.app/chat

# Authentication: token | password
AUTH_MODE=token
ACCESS_TOKEN=
TOKEN_STORAGE_KEY=accessToken

# Password auth (when AUTH_MODE=password)
USERNAME=
PASSWORD=

# Timeouts (milliseconds)
TIMEOUT=30000
NAVIGATION_TIMEOUT=60000

# Login verification – chat input visible means authenticated
LOGIN_SUCCESS_SELECTOR=textarea.q-field__native.bidi-textarea
SESSION_EXPIRED_SELECTOR=

# Chat UI selectors
CHAT_INPUT_SELECTOR=textarea.q-field__native.bidi-textarea
CHAT_SUBMIT_SELECTOR=button.submit-btn-v2
CHAT_ANSWER_SELECTOR=.q-message-text--received .q-message-text-content

# How long to wait for the model reply (milliseconds)
ANSWER_TIMEOUT=120000

# Test message
TEST_MESSAGE=سلام! این یک پیام تست از سرویس اتوماسیون است.

# Storage paths (relative to project root)
STORAGE_STATE_PATH=storage/state.json
LOG_DIR=storage/logs
LOG_LEVEL=INFO

# Retry configuration
RETRY_MAX_ATTEMPTS=3
RETRY_MIN_WAIT_SECONDS=1
RETRY_MAX_WAIT_SECONDS=10
