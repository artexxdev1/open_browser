# Browser
HEADLESS=true
BROWSER_NAME=firefox
WARM_ON_START=false
HOST=0.0.0.0
PORT=8000

# GapGPT
BASE_URL=https://gapgpt.app/chat
LOGIN_URL=https://gapgpt.app/chat
AUTH_MODE=cookie
ACCESS_TOKEN=
TOKEN_COOKIE_NAME=accessToken
TOKEN_STORAGE_KEY=accessToken
COOKIE_DOMAIN=gapgpt.app

# Optional protect API with header: X-API-Key
API_KEY=

# Timeouts (milliseconds)
TIMEOUT=30000
NAVIGATION_TIMEOUT=60000
ANSWER_TIMEOUT=180000

# Chat UI selectors
LOGIN_SUCCESS_SELECTOR=textarea.q-field__native.bidi-textarea
CHAT_INPUT_SELECTOR=textarea.q-field__native.bidi-textarea
CHAT_SUBMIT_SELECTOR=button:has(.material-icons:has-text("arrow_upward"))
CHAT_ANSWER_SELECTOR=.markdown-container

LOG_LEVEL=INFO
STORAGE_STATE_PATH=storage/state.json
LOG_DIR=storage/logs
